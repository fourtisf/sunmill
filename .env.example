# ─────────────────────────────────────────────────────────────
# SUNMIL — environment. Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── API (sunmil-api / Fastify) ──────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0

# Postgres (Prisma)
# The database name is infrastructure, not branding: an existing install keeps
# whatever it was provisioned with. Only a fresh box needs to match this.
# Always quote this. In production it grows a query string, and the first
# unquoted & turns the rest of the line into a shell command.
DATABASE_URL="postgresql://sunmil:sunmil@127.0.0.1:5432/sunmil?schema=public"

# Redis (sessions cache, market/order board cache, rate-limit buckets)
REDIS_URL=redis://127.0.0.1:6379

# Auth. JWT_SECRET must be a long random string (openssl rand -hex 48).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_SECONDS=604800
COOKIE_NAME=sunmil_session
# Set to the apex domain in production so the cookie is shared by www/api hosts.
COOKIE_DOMAIN=
# true in production (HTTPS only)
COOKIE_SECURE=false

# Browser origin(s) allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:3000

# ── Game balance ─────────────────────────────────────────────
# Multiplies EVERY duration in server/src/config/gamedata.ts (crop grow,
# machine craft, animal produce). 1 = the prototype's demo pace (~20x fast).
# HANDOFF §2.1 recommends 20 for a real Hay Day cadence — NOT locked in yet,
# needs ALFA sign-off. Change here, restart the API, no code edits.
TIME_SCALE=1

# ── $HAY / Robinhood Chain (HANDOFF §7) ──────────────────────
# Master switch for the on-chain withdraw/deposit endpoints. Leave false
# until ALFA signs off on emission + sinks. Off-chain `hay` works regardless.
HAY_ONCHAIN_ENABLED=false
# Max game-hay a single wallet may withdraw per rolling 24h.
HAY_WITHDRAW_DAILY_CAP=50
# Withdrawals at or above this amount are held for manual review.
HAY_WITHDRAW_REVIEW_THRESHOLD=25
# Robinhood Chain RPC + treasury. Server-side only — never sent to the client.
CHAIN_RPC_URL=
CHAIN_ID=
HAY_TOKEN_ADDRESS=
TREASURY_ADDRESS=
TREASURY_PRIVATE_KEY=
# Confirmations required before a deposit is credited.
CHAIN_MIN_CONFIRMATIONS=12
# NOTE: every setting above is EVM-shaped and predates the move to Solana.
# lib/chain.ts has not been rewritten yet, so HAY_ONCHAIN_ENABLED must stay
# false — see docs/RUNBOOK.md §9. Off-chain hay is unaffected.

# ── Closed beta ──────────────────────────────────────────────
# Gate on the landing page. Nobody can open a session — wallet or dev login —
# without posting this code first, so it is enforced here rather than in the
# browser. Leave it EMPTY and there is no gate at all (local dev, CI).
# A short numeric code is fine for a small private beta, but it is guessable:
# the route allows 10 attempts per IP per 10 minutes, which slows one attacker
# down and does nothing about a hundred. Use something long before opening up.
INVITE_CODE=
# How long a browser stays through the gate once it has passed. Default 30 days.
INVITE_TTL_SECONDS=2592000

# ── Operator access ──────────────────────────────────────────
# Second factor for /api/admin (releasing or rejecting held $HAY withdrawals).
# A user flagged isAdmin must ALSO send this as the X-Admin-Token header.
# Leave empty and the admin routes do not exist at all. Min 24 chars.
ADMIN_TOKEN=

# ── Web (sunmil-web / Next.js) ──────────────────────────────
WEB_PORT=3000
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000
